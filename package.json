{
  "name": "bullpen",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.16" },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @bullpen/server",
    "dev:web": "npm run dev -w @bullpen/web",
    "build": "npm run build -w @bullpen/web && npm run build -w @bullpen/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
