{
  "name": "bullpen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @bullpen/server",
    "dev:web": "npm run dev -w @bullpen/web",
    "dev:managed": "mkdir -p \"$HOME/.bullpen-managed/claude\" && BULLPEN_DATA=\"$HOME/.bullpen-managed\" CLAUDE_CONFIG_DIR=\"$HOME/.bullpen-managed/claude\" npm run dev",
    "dev:managed:fresh": "rm -rf \"$HOME/.bullpen-managed\" && npm run dev:managed",
    "deploy": "kamal deploy --skip-push --version \"$(git rev-parse HEAD)\"",
    "deploy:setup": "kamal setup --skip-push --version \"$(git rev-parse HEAD)\"",
    "build": "npm run build -w @bullpen/web && npm run build -w @bullpen/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "node --env-file-if-exists=.env --experimental-strip-types packages/server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
