{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": { "Proxy": "http://bullpen:4322" }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/api/hooks": { "Proxy": "http://bullpen:4322/api/hooks" }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:8443": true
  }
}
