# Read by Kamal with dotenv semantics; values come from the shell, never from
# this file. GITHUB_TOKEN needs read:packages so the server can pull
# ghcr.io/bradymholt/bullpen.
KAMAL_REGISTRY_PASSWORD=$GITHUB_TOKEN
# Set by the deploy workflow to the release it is creating (v12, …); the footer
# links to it. Empty for a deploy from a laptop, which then links to the commit.
BULLPEN_RELEASE=$BULLPEN_RELEASE

# Tailscale auth key for the server's node (admin console → Settings → Keys).
# Used once; the node's state lives in the accessory's volume afterwards.
TS_AUTHKEY=$TS_AUTHKEY
