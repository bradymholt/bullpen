# Where SQLite and all agent workspaces live. Keep it OUTSIDE this checkout:
# a workspace nested under a repo inherits that repo's CLAUDE.md.
# Defaults to ~/.bullpen when unset.
# BULLPEN_DATA=~/.bullpen
PORT=4322

# Claude credentials — pick ONE.
# 1. Subscription (recommended): run `claude setup-token` on a machine that is
#    logged in, then paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# 2. Or point at a mounted config dir holding .credentials.json
# CLAUDE_CONFIG_DIR=/data/claude
# 3. Or fall back to a plain API key.
# ANTHROPIC_API_KEY=

# How long a permission prompt waits before it is denied automatically. An
# unattended run has nobody to answer one, and a pending prompt blocks the agent.
# BULLPEN_APPROVAL_TIMEOUT_MS=900000

# Used to clone private repos and open pull requests. Optional here: the same
# variable set under Settings → Global environment in the dashboard is used
# when this is empty, which is what a headless box wants.
GITHUB_TOKEN=

# Where the internet reaches /api/hooks, if that differs from the address you open the
# dashboard on (e.g. a funneled port beside a tailnet-only one). The UI builds every webhook
# URL from this when set; otherwise it uses the browser's own origin.
# BULLPEN_PUBLIC_URL=https://<node>.<tailnet>.ts.net:8443
