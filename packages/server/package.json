    "hono": "^4.6.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "vitest": "^5.0.1"
